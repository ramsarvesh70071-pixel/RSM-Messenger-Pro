# ==============================================================================
# RSM MESSENGER - ROOT / MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to server/.env, admin/.env, and client/.env where applicable.
# ==============================================================================

# --- SERVER CONFIGURATION ---
PORT=5000
NODE_ENV=development
APP_NAME="RSM Messenger"
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173

# --- DATABASE (MONGODB) ---
# Local MongoDB instance or MongoDB Atlas Connection String
MONGODB_URI=mongodb://localhost:27017/rsm_messenger

# --- JWT SECURITY CONFIGURATION ---
# Generate strong 256-bit random keys for production (e.g. openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_access_token_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- OTP & SMS AUTHENTICATION ---
# In production, MOCK_OTP_ENABLED must be false. Use real SMS providers.
# Development: true (OTP is always 123456, demo accounts work). MUST be false in production.
MOCK_OTP_ENABLED=true
MOCK_OTP_CODE=123456
OTP_EXPIRY_MINUTES=5

# Production SMS Providers (Uncomment & configure when going live):
# SMS_PROVIDER=twilio # Options: mock | twilio | aws_sns | messagebird
# TWILIO_ACCOUNT_SID=AC_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+1234567890

# --- STORAGE & MEDIA ABSTRACTION ---
# Options: local | s3 | minio | digitalocean
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/webm
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/ogg,audio/wav,audio/m4a,audio/webm
ALLOWED_DOC_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/zip,text/plain

# AWS S3 / Cloud Object Storage (if STORAGE_DRIVER=s3):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=rsm-messenger-media
# AWS_S3_ENDPOINT= # For MinIO or Custom S3-compatible storage

# --- WEBRTC CALLING & STUN/TURN CONFIGURATION ---
# Free public STUN server list (comma-separated)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Production TURN configuration (Optional, required for strict symmetric NATs):
# TURN_SERVERS=turn:turn.yourdomain.com:3478
# TURN_USERNAME=turnuser
# TURN_CREDENTIAL=turnpassword

# --- PUSH NOTIFICATIONS ---
# Push notification provider: mock | fcm | apns
PUSH_PROVIDER=mock
# Firebase Cloud Messaging Service Account (Path to JSON or Raw JSON):
# FCM_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# --- RATE LIMITING ---
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=1000 # 1000 requests per 15 min

# --- CORS SETTINGS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://127.0.0.1:3000,http://127.0.0.1:5173
# In development, any LAN origin (192.168.x.x / 10.x.x.x / 172.16-31.x.x) is allowed automatically.
