# RSM Messenger Client Environment Variables
# Leave BOTH empty in development: Vite proxies /api, /uploads and /socket.io to the backend,
# so the app also works from a phone opened via http://<your-PC-LAN-IP>:3000
# (a hard-coded "localhost" would point to the phone itself and every request would fail).
VITE_API_URL=
VITE_SOCKET_URL=
# Production example (separate backend host):
# VITE_API_URL=https://api.example.com
# VITE_SOCKET_URL=https://api.example.com
